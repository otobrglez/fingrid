object BuildConfig:
  /** JVM options to silence Scala 3 LazyVals sun.misc.Unsafe deprecation warnings (JDK 21+) */
  val lazyValsJvmArgs: Seq[String] = Seq(
    "--enable-native-access=ALL-UNNAMED",
    "--sun-misc-unsafe-memory-access=allow",
    "--add-opens=java.base/java.util=ALL-UNNAMED",
    "--add-opens=java.base/jdk.internal.misc=ALL-UNNAMED",
    "--add-opens=jdk.unsupported/sun.misc=ALL-UNNAMED",
    "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED",
    "--add-exports=java.base/sun.reflect.misc=ALL-UNNAMED"
  )

sealed trait FinGridScalaModule extends ScalaModule:
  def forkArgs = super.forkArgs() ++ BuildConfig.lazyValsJvmArgs

  def javacOptions = Seq("--release", "25")

  def scalaVersion = "3.8.1"

  def scalacOptions = Seq(
    "-encoding",
    "utf-8",
    "-feature",
    "-language:implicitConversions",
    "-language:higherKinds",
    "-unchecked",
    "-deprecation",
    "-Xkind-projector"
    // "-Yfuture-lazy-vals"
  )

object `fingrid-persistence` extends JavaModule:
  def compileMvnDeps = super.compileMvnDeps() ++ Set(
    mvn"org.hibernate.orm:hibernate-jpamodelgen:7.2.4.Final"
  )

  override def javacOptions = Seq(
    "-proc:full",
    "--release",
    "25"
  )

  def mvnDeps = super.mvnDeps() ++ {
    Dependencies.hibernate ++ Dependencies.logbackClassic
  }

object `zio-hibernate` extends FinGridScalaModule:
  def mvnDeps = super.mvnDeps() ++ {
    Dependencies.zio ++ Dependencies.zioLogging ++ Dependencies.hibernate
  }

  object test extends FinGridScalaModule, ScalaTests:
    def mvnDeps = super.mvnDeps() ++ {
      Dependencies.zioTest ++ Dependencies.h2Database ++ Dependencies.zioLogging ++ Dependencies.logbackClassic
    }

    def testFramework = "zio.test.sbt.ZTestFramework"

object info extends FinGridScalaModule with BuildInfo with GitVersionedPublishModule:
  private val Description  = "A tool for financial management."
  private val Developers   = Seq(Developer("otobrglez", "Oto Brglez", "https://github.com/otobrglez"))
  private val Licences     = Seq(License.MIT)
  private val Organization = "fingrid"
  private val ProjectName  = "fingrid"
  private val Url          = "https://github.com/otobrglez/fingrid"
  private val VC           = VersionControl.github("otobrglez", "fingrid")

  val buildInfoPackageName = "fingrid.info"

  override def pomSettings = PomSettings(
    description = Description,
    organization = Organization,
    url = Url,
    licenses = Licences,
    versionControl = VC,
    developers = Developers
  )

  override def publishVersion = GitVersionModule.version(withSnapshotSuffix = true)()

  def buildInfoMembers = Seq(
    BuildInfo.Value("version", publishVersion()),
    BuildInfo.Value("scalaVersion", scalaVersion())
  )

object `fingrid-service` extends FinGridScalaModule with DockerModule:
  def moduleDeps = Seq(info, `zio-hibernate`, `fingrid-persistence`)

  def mvnDeps = super.mvnDeps() ++ {
    Dependencies.zioConfig ++
      Dependencies.logbackClassic ++ Dependencies.zio ++ Dependencies.zioHttp ++ Dependencies.zioLogging ++
      Dependencies.postgresql ++ Dependencies.jwt ++ Dependencies.bcrypt ++ Dependencies.zioSchema
  }

  object docker extends DockerConfig:
    def baseImage    = "azul/zulu-openjdk:25-jre-headless-latest"
    def tags         = List(
      "ghcr.io/otobrglez/fingrid-service",
      s"ghcr.io/otobrglez/fingrid-service:${GitVersionModule.version(withSnapshotSuffix = true)()}",
      "fingrid-service:latest",
      s"fingrid-service:${GitVersionModule.version(withSnapshotSuffix = true)()}"
    )
    def exposedPorts = Seq(7778)
    def executable   = "docker"

    def envVars = Map(
      "JAVA_TOOL_OPTIONS" -> BuildConfig.lazyValsJvmArgs.mkString("\"", " ", "\"")
    )

  object test extends FinGridScalaModule, ScalaTests:
    def mvnDeps = super.mvnDeps() ++ {
      Dependencies.zioTest ++ Dependencies.zioHttpTestKit
    }

    def testFramework = "zio.test.sbt.ZTestFramework"
