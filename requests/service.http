### Login - Get Access Token from Keycloak
POST {{keycloak_url}}/realms/{{keycloak_realm}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

client_id={{keycloak_client_id}}&username={{username}}&password={{password}}&grant_type=password&scope=openid profile email

> {%
    client.global.set("access_token", response.body.access_token);
    client.global.set("refresh_token", response.body.refresh_token);
%}

### Get User Info from /me endpoint
GET {{service_url}}/me
Authorization: Bearer {{access_token}}

### Refresh Token
POST {{keycloak_url}}/realms/{{keycloak_realm}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

client_id={{keycloak_client_id}}&grant_type=refresh_token&refresh_token={{refresh_token}}

> {%
    client.global.set("access_token", response.body.access_token);
    client.global.set("refresh_token", response.body.refresh_token);
%}

### Get User Info from Keycloak
GET {{keycloak_url}}/realms/{{keycloak_realm}}/protocol/openid-connect/userinfo
Authorization: Bearer {{access_token}}


### Get namespaces
GET {{service_url}}/namespaces
Authorization: Bearer {{access_token}}


### Create namespace
POST {{service_url}}/namespaces
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "name": "Family"
}

### Create namespace
POST {{service_url}}/namespaces
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "name": "Corporate"
}

> {%
    client.global.set("namespace_id", response.body.id);
%}

### Get categories for a namespace
GET {{service_url}}/namespaces/{{namespace_id}}/categories
Authorization: Bearer {{access_token}}

### Get category by ID
GET {{service_url}}/categories/{{category_id}}
Authorization: Bearer {{access_token}}

### Create category
POST {{service_url}}/categories
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "name": "Food & Groceries",
  "namespace_id": "{{namespace_id}}"
}

> {%
    client.global.set("category_id", response.body.id);
%}

### Update category
PATCH {{service_url}}/categories/{{category_id}}
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "name": "Food & Dining"
}

### Delete category
DELETE {{service_url}}/categories/{{category_id}}
Authorization: Bearer {{access_token}}

